{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalystflow.local/schemas/structure_resolution.schema.json",
  "title": "CatalystFlow structure resolution result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "request_id",
    "status",
    "resolved_roles",
    "all_usable",
    "blocking_reasons",
    "next_action"
  ],
  "properties": {
    "mode": {"const": "structure_resolution"},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "status": {
      "enum": ["cache_hit", "resolved_pending_cache_review", "manual_review_required"]
    },
    "resolved_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "variable",
          "value",
          "status",
          "canonical_smiles",
          "source",
          "review_status"
        ]
      }
    },
    "all_usable": {"type": "boolean"},
    "blocking_reasons": {"type": "array"},
    "next_action": {
      "enum": ["run_existing_feature_builder", "request_human_review"]
    }
  }
}
